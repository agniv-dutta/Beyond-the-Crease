{
  "name": "beyond-the-crease",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Beyond the Crease — AI-style storytelling, visibility parity tracking and inclusive multilingual fan communities for women's sport. Frontend-only prototype for the ICC Global Hackathon, Track 1.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
